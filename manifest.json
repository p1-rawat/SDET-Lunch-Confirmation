{
    "name": "SDET Tech. Lunch Confirmation",
    "version": "1.0",
    "manifest_version": 3,
    "description": "Automate lunch confirmation",
    "permissions": [
        "activeTab",
        "tabs",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://lunch-booking.netlify.app/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "extensionLogo.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://lunch-booking.netlify.app/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/extensionLogo16.png",
        "32": "icons/extensionLogo32.png",
        "48": "icons/extensionLogo48.png",
        "128": "icons/extensionLogo128.png"
    }
}